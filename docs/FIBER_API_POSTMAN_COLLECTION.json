{
  "info": {
    "name": "Fiber Payment API",
    "description": "Complete API collection for CKB Fiber payments integration",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"business@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Fiber Setup",
      "item": [
        {
          "name": "Enable Fiber",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fiberChannelId\": \"ckt1qzda89q270w8pz3ak4m8hzcw7wz6pwc8r5k6jg\",\n  \"fiberPeerId\": \"0x1234567890abcdef\",\n  \"fiberNodeUrl\": \"http://127.0.0.1:8227\",\n  \"acceptCkb\": true,\n  \"acceptSudt\": true,\n  \"autoConvertDaily\": false,\n  \"autoConvertThreshold\": 500,\n  \"settlementSchedule\": \"daily\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/business/fiber/setup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "business", "fiber", "setup"]
            }
          },
          "response": []
        },
        {
          "name": "Get Fiber Settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/business/fiber/setup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "business", "fiber", "setup"]
            }
          },
          "response": []
        },
        {
          "name": "Update Settlement Preferences",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"autoConvertDaily\": true,\n  \"autoConvertThreshold\": 500,\n  \"settlementSchedule\": \"weekly\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/business/fiber/settlement",
              "host": ["{{baseUrl}}"],
              "path": ["api", "business", "fiber", "settlement"]
            }
