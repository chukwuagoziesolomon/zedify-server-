            "url": {
              "raw": "{{baseUrl}}/api/business/fiber/accept-sudt/0x1142755a044bf2ee358cba9f2da187ce928c91cd4dc8692ded0337efa677d21a",
              "host": ["{{baseUrl}}"],
              "path": ["api", "business", "fiber", "accept-sudt", "0x1142755a044bf2ee358cba9f2da187ce928c91cd4dc8692ded0337efa677d21a"]
            }
          },
          "response": []
